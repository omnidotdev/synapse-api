# database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synapse?schema=public"

# GraphQL
# https://escape.tech/graphql-armor/docs/plugins/cost-limit
GRAPHQL_MAX_COMPLEXITY_COST="400"

# allowed origins for CORS (comma-separated) (https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Access-Control-Allow-Origin)
CORS_ALLOWED_ORIGINS="https://localhost:3000"

# gateway shared secret (for internal endpoints called by beacon-gateway etc.)
# Generate: openssl rand -base64 32
# Must match SYNAPSE_GATEWAY_SECRET in beacon-gateway
GATEWAY_SECRET=

# feature flags
FLAGS_CLIENT_KEY=

# external provider URLs
# BILLING_BASE_URL=
# AUTHZ_API_URL=
# AUTHZ_ENABLED=true

# Vortex (event streaming)
VORTEX_API_URL="https://localhost:5000"
VORTEX_API_KEY=""

# event streaming (Iggy)
# IGGY_HOST=localhost
# IGGY_PORT=8090
# IGGY_USERNAME=iggy
# IGGY_PASSWORD=iggy
