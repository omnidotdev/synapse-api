{
  "name": "@omnidotdev/synapse-api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Omni <team@omni.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/omnidotdev/synapse-api.git"
  },
  "main": "build/server.js",
  "module": "build/server.js",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "NODE_ENV=development GRAPHILE_ENV=development bun run --watch src/server.ts",
    "build": "bun build --target node --outdir build src/server.ts src/instrumentation.ts",
    "start": "NODE_ENV=production GRAPHILE_ENV=production bun run src/scripts/db/migrate.ts && NODE_ENV=production GRAPHILE_ENV=production bun run --import ./build/instrumentation.js build/server.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "knip": "knip-bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "db:setup": "bun src/scripts/db/setupDatabase.ts",
    "db:check": "bun --env-file .env.local drizzle-kit check --config src/lib/config/drizzle.config.ts",
    "db:generate": "bun --env-file .env.local drizzle-kit generate --config src/lib/config/drizzle.config.ts",
    "db:migrate": "bun --env-file .env.local drizzle-kit migrate --config src/lib/config/drizzle.config.ts && GRAPHILE_ENV=development bun graphql:generate",
    "db:migrate:drop": "bun --env-file .env.local drizzle-kit drop --config src/lib/config/drizzle.config.ts",
    "db:pull": "bun --env-file .env.local drizzle-kit introspect --config src/lib/config/drizzle.config.ts",
    "db:push": "bun --env-file .env.local drizzle-kit push --config src/lib/config/drizzle.config.ts",
    "db:seed": "NODE_ENV=development bun run --env-file .env.local src/scripts/db/seedDatabase.ts",
    "db:studio": "bun --env-file .env.local drizzle-kit studio --config src/lib/config/drizzle.config.ts",
    "db:up": "bun --env-file .env.local drizzle-kit up --config src/lib/config/drizzle.config.ts",
    "graphql:generate": "GRAPHILE_ENV=development bun run --env-file .env.local src/scripts/generateGraphqlSchema.ts",
    "prepare": "husky"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "msw"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@faker-js/faker": "^10.4.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bun": "^1.3.14",
    "@types/ms": "^2.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "msw": "^2.14.6",
    "testcontainers": "^11.14.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/graphql-yoga": "^1.4.1",
    "@envelop/generic-auth": "^11.1.1",
    "@envelop/opentelemetry": "^9.1.1",
    "@envelop/parser-cache": "^10.1.1",
    "@envelop/validation-cache": "^10.1.1",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@graphile/simplify-inflection": "8.0.0",
    "@graphql-yoga/plugin-disable-introspection": "^2.22.0",
    "@iggy.rs/sdk": "^1.0.6",
    "@omnidotdev/providers": "github:omnidotdev/providers#49f2fc4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@tanstack/query-core": "^5.100.10",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "elysia-rate-limit": "^4.6.2",
    "grafast": "1.0.1",
    "graphile-export": "1.0.1",
    "graphile-utils": "5.0.1",
    "graphql": "16.13.2",
    "graphql-yoga": "^5.21.0",
    "jose": "^6.2.3",
    "ms": "^2.1.3",
    "pg": "^8.21.0",
    "postgraphile": "5.0.3",
    "postgraphile-plugin-connection-filter": "3.0.1"
  },
  "overrides": {
    "graphql": "16.13.2",
    "grafast": "1.0.1",
    "pg-sql2": "5.0.0-rc.5"
  }
}
